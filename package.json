{
  "name": "stashwise-obsidian",
  "version": "1.0.4",
  "description": "Stashwise for Obsidian: sync your saved library and wiki into your vault, search it inline, and capture notes back.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production && node scripts/verify-mobile.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:mobile": "node scripts/verify-mobile.mjs",
    "e2e": "bash scripts/e2e-full.sh"
  },
  "keywords": [
    "obsidian-plugin",
    "stashwise"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.12.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "latest",
    "tslib": "^2.8.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^2.0.0"
  }
}
